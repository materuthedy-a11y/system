# Local development example only. In production, set real values in the hosting platform.
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
JWT_RESET_SECRET=replace-with-another-random-secret-of-at-least-32-characters
API_PORT=3002
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SESSION_IDLE_TIMEOUT=7d
SESSION_ABSOLUTE_TIMEOUT=30d
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d
ALLOW_NEGATIVE_STOCK=false
DEFAULT_COSTING_METHOD=WEIGHTED_AVERAGE
LOG_LEVEL=info
# Add a unique random value of at least 32 characters if notification credentials are configured.
# NOTIFICATION_CONFIG_ENCRYPTION_KEY=
